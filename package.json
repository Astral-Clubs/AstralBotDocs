{
  "name": "astral-bot-docs",
  "private": true,
  "type": "module",
  "description": "Документация Astral Moderation: шаблоны сообщений и пользовательские команды",
  "license": "(MIT AND CC-BY-4.0)",
  "homepage": "https://docs.astralbs.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astral-Clubs/AstralBotDocs.git"
  },
  "bugs": {
    "url": "https://github.com/Astral-Clubs/AstralBotDocs/issues"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "check": "bun scripts/check-docs.ts",
    "check:comments": "bun scripts/check-comments.ts",
    "test": "bun test",
    "verify": "bun run check && bun run check:comments && bun run test && bun run build",
    "deploy:dry": "bun run build && wrangler deploy --env production --dry-run",
    "deploy": "bun run verify && wrangler deploy --env production"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@mdi/js": "^7.4.47",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "wrangler": "4.135.0"
  }
}
